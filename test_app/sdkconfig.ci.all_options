CONFIG_MRUBYC_MAX_VM_COUNT=7
CONFIG_MRUBYC_MAX_REGS_SIZE=160
CONFIG_MRUBYC_MAX_SYMBOLS_COUNT=320
CONFIG_MRUBYC_FLOAT_SINGLE=y
CONFIG_MRUBYC_USE_MATH=y
CONFIG_MRUBYC_USE_STRING_UTF8=y
CONFIG_MRUBYC_USE_UNICODE_CASE=y
CONFIG_MRUBYC_INT64=y
# CONFIG_MRUBYC_SUPPORT_OP_EXT is not set
CONFIG_MRUBYC_ALLOC_LIBC=y
CONFIG_MRUBYC_NO_TIMER=y
# CONFIG_MRUBYC_SCHEDULER_EXIT is not set
CONFIG_FREERTOS_HZ=1000
CONFIG_MRUBYC_TICK_1_MS=y
CONFIG_MRUBYC_TIMESLICE_TICK_COUNT=2
# CONFIG_MRUBYC_DEBUG is not set
CONFIG_MRUBYC_CONVERT_CRLF=y
