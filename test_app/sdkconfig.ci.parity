CONFIG_MRUBYC_TEST_PARITY=y
CONFIG_MRUBYC_STRING_SIZE_32=y
CONFIG_MRUBYC_ALLOC_PROFILING=y
CONFIG_MRUBYC_ALLOC_FLI_BIT_WIDTH=8
CONFIG_MRUBYC_ALLOC_SLI_BIT_WIDTH=2
CONFIG_MRUBYC_ALLOC_IGNORE_LSBS=5
CONFIG_MRUBYC_MIN_MEMORY_BLOCK_SIZE=32
CONFIG_MRUBYC_SYMBOL_SEARCH_LINEAR=y
CONFIG_MRUBYC_EXCEPTION_CALL_NEST_LEVEL=4
CONFIG_MRUBYC_TASK_NAME_LEN=8
CONFIG_MRUBYC_KV_SIZE_INIT=3
CONFIG_MRUBYC_KV_SIZE_INCREMENT=4
CONFIG_MRUBYC_NO_STDIO=y
CONFIG_MRUBYC_DEBUG_REGS=y
CONFIG_MRUBYC_DISABLE_LEGACY_VALUE_MACROS=y
CONFIG_MRUBYC_PANIC_ON_UNHANDLED_EXCEPTION=y
